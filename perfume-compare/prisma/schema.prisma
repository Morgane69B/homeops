// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  HOMME
  FEMME
  MIXTE
}

enum Concentration {
  EXTRAIT_DE_PARFUM
  EAU_DE_PARFUM
  EAU_DE_TOILETTE
  EAU_DE_COLOGNE
}

enum NoteCategory {
  HEAD
  HEART
  BASE
}

enum Role {
  USER
  ADMIN
}

// --- Auth (NextAuth / Auth.js Prisma adapter) ---

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  name          String?
  image         String?
  role          Role      @default(USER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  wishlist WishlistItem[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Catalogue ---

model OlfactoryFamily {
  id          String @id @default(cuid())
  name        String @unique
  slug        String @unique
  description String

  perfumes Perfume[]
}

model Note {
  id       String       @id @default(cuid())
  name     String       @unique
  category NoteCategory

  perfumes Perfume[]
}

model Perfume {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  brand           String
  gender          Gender
  concentration   Concentration
  description     String
  imageUrl        String?
  image3dModelUrl String?
  createdAt       DateTime      @default(now())

  mainFamilyId String
  mainFamily   OlfactoryFamily @relation(fields: [mainFamilyId], references: [id])

  notes        Note[]
  offers       PriceOffer[]
  wishlistedBy WishlistItem[]
  articles     Article[]
}

model Merchant {
  id      String @id @default(cuid())
  name    String @unique
  logoUrl String?
  siteUrl String

  offers PriceOffer[]
}

model PriceOffer {
  id           String   @id @default(cuid())
  price        Decimal  @db.Decimal(10, 2)
  volumeMl     Int
  stock        Boolean  @default(true)
  affiliateUrl String
  isOfficial   Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  perfumeId  String
  perfume    Perfume  @relation(fields: [perfumeId], references: [id], onDelete: Cascade)
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([perfumeId, merchantId, volumeMl])
}

model WishlistItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  perfumeId String
  perfume   Perfume @relation(fields: [perfumeId], references: [id], onDelete: Cascade)

  @@unique([userId, perfumeId])
}

// --- Site content ---

model SiteSettings {
  id String @id @default("singleton")

  heroEyebrow      String
  heroTitle        String
  heroDescription  String
  heroCtaPrimary   String
  heroCtaSecondary String

  pillar1Title       String
  pillar1Description String
  pillar2Title       String
  pillar2Description String
  pillar3Title       String
  pillar3Description String

  familiesEyebrow String
  familiesTitle   String

  footerTagline String

  updatedAt DateTime @updatedAt
}

model GuideTip {
  id        String   @id @default(cuid())
  title     String
  body      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// --- Legal ---

model LegalPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String
  updatedAt DateTime @updatedAt
}

// --- Blog ---

model Article {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  content    String
  excerpt    String
  coverImage String?
  createdAt  DateTime @default(now())

  perfumes Perfume[]
}
